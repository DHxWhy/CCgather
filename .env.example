# ══════════════════════════════════════════════════════════
# App
# ══════════════════════════════════════════════════════════
NEXT_PUBLIC_APP_URL=https://ccgather.com
NEXT_PUBLIC_APP_NAME=CCgather

# ══════════════════════════════════════════════════════════
# Clerk (Authentication)
# ══════════════════════════════════════════════════════════
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Redirect URLs (Optional - already hardcoded in app/layout.tsx & app/sso-callback/page.tsx)
# NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/leaderboard
# NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# ══════════════════════════════════════════════════════════
# Supabase (Database)
# ══════════════════════════════════════════════════════════
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx
SUPABASE_ACCESS_TOKEN=sbp_xxxxx

# ══════════════════════════════════════════════════════════
# AI (for news summarization) - INTERNAL USE ONLY
# ══════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ══════════════════════════════════════════════════════════
# Google Gemini (for thumbnail generation) - Optional
# ══════════════════════════════════════════════════════════
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here

# ══════════════════════════════════════════════════════════
# Cron Jobs (News Automation)
# ══════════════════════════════════════════════════════════
# Secret for authenticating cron job requests
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# ══════════════════════════════════════════════════════════
# PostHog Analytics
# ══════════════════════════════════════════════════════════
# Get from: https://us.posthog.com/settings/project-settings
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Admin API - Get from: https://us.posthog.com/settings/user-api-keys
# Used for Admin Dashboard analytics data fetching
POSTHOG_PERSONAL_API_KEY=phx_xxxxx
POSTHOG_PROJECT_ID=12345

# ══════════════════════════════════════════════════════════
# Error Tracking (Optional)
# ══════════════════════════════════════════════════════════
SENTRY_DSN=

# ══════════════════════════════════════════════════════════
# GitHub API (Optional)
# ══════════════════════════════════════════════════════════
# Fallback token for the CLI star-nudge check (stargazers lookup).
# A classic PAT with NO scopes is enough — public repo stargazers only
# require authentication. NEVER use a token with repo scope here: if the
# env var leaks it would grant write access to repositories.
# (Named GITHUB_STAR_TOKEN, not GITHUB_TOKEN, to avoid collision with the
# reserved variable GitHub Actions injects into CI environments.)
# Get from: https://github.com/settings/tokens
GITHUB_STAR_TOKEN=
